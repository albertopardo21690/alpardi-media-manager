# Copia a .env (ignorado por git) y rellena solo si no se usa un gestor de secretos del sistema.
# Nunca reales aquí. Las referencias credential_ref en config/*.yaml son el método preferido.

# Plex (reutiliza el token ya existente de AlpardiOS -- no crear uno nuevo,
# ver docs/DECISIONS.md):
ALPARDI_MEDIA_PLEX_TOKEN_REF=file:///root/.config/alpardios/plex.env
ALPARDI_MEDIA_PLEX_BASE_URL=http://100.75.202.28:32400

# NAS (acceso por SSH/SFTP, nunca SQLite sobre SMB -- ver docs/DECISIONS.md):
ALPARDI_MEDIA_NAS_SSH_HOST=NASAlpardimedia

# Proveedores -- todos vacíos hasta que Alberto genere cada cuenta (ver docs/PROVIDERS.md):
ALPARDI_MEDIA_TMDB_TOKEN_REF=
ALPARDI_MEDIA_THETVDB_API_KEY_REF=
ALPARDI_MEDIA_FANART_PROJECT_KEY_REF=
ALPARDI_MEDIA_OPENSUBTITLES_API_KEY_REF=
